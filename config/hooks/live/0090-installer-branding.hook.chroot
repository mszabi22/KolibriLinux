#!/bin/bash
# Calamares telepítő: Kolibri arculat bekapcsolása (a 0100 hook előtt kell lefutnia,
# mert az másolja az indítót az asztalra).
set -e

CONF=/etc/calamares/settings.conf
if [ -f "$CONF" ]; then
    if grep -q '^branding:' "$CONF"; then
        sed -i 's/^branding:.*/branding: kolibri/' "$CONF"
    else
        echo 'branding: kolibri' >> "$CONF"
    fi
fi

# Az asztali indító neve és ikonja is Kolibri legyen
for f in /usr/share/applications/calamares.desktop /usr/share/applications/install-debian.desktop; do
    [ -f "$f" ] || continue
    sed -i -e '/^Name\[.*\]=/d' -e '/^GenericName\[.*\]=/d' -e '/^Comment\[.*\]=/d' \
           -e 's/^Name=.*/Name=Kolibri Linux telepítése/' \
           -e 's|^Icon=.*|Icon=/usr/share/kolibri/logo.png|' "$f"
done
exit 0
