#!/bin/bash
# Plymouth téma beállítása (a telepített rendszerbe is átkerül)
set -e
if [ -d /usr/share/plymouth/themes/kolibri ]; then
    plymouth-set-default-theme kolibri
    update-initramfs -u || true
fi

# GRUB menü: "Kolibri Linux GNU/Linux" helyett "Kolibri Linux".
# A 10_linux-hoz nem nyúlunk (nincs divert): minden apt/dpkg futás után átírjuk a grub.cfg-t.
cat > /etc/apt/apt.conf.d/99kolibri-grub <<'EOF'
DPkg::Post-Invoke { "[ -f /boot/grub/grub.cfg ] && sed -i 's|Kolibri Linux GNU/Linux|Kolibri Linux|g' /boot/grub/grub.cfg || true"; };
EOF
exit 0