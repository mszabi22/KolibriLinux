# Kolibri Linux Plymouth téma
# Mély tengerkék háttér, enyhén "lélegző" logó, vékony haladássáv.
# Jelszókérés (titkosított lemez) és üzenetek támogatva.

Window.SetBackgroundTopColor(0.051, 0.129, 0.212);
Window.SetBackgroundBottomColor(0.024, 0.067, 0.118);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;

# --- Logó és felirat ---
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2,
                        screen_h * 0.36 - logo.image.GetHeight() / 2, 10);

word.image = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(cx - word.image.GetWidth() / 2,
                        screen_h * 0.36 + logo.image.GetHeight() / 2 + 10, 10);

# --- Haladássáv ---
bar_w = Math.Min(Math.Int(screen_w * 0.28), 420);
bar_h = 4;
bar_x = cx - bar_w / 2;
bar_y = screen_h * 0.72;

track.original = Image("track.png");
track.sprite = Sprite(track.original.Scale(bar_w, bar_h));
track.sprite.SetPosition(bar_x, bar_y, 5);

fill.original = Image("fill.png");
fill.sprite = Sprite(fill.original.Scale(1, bar_h));
fill.sprite.SetPosition(bar_x, bar_y, 6);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 1) w = 1;
    if (w > bar_w) w = bar_w;
    fill.sprite.SetImage(fill.original.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- Finom pulzálás: jelzi, hogy a rendszer dolgozik, nem fagyott le ---
tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.86 + 0.14 * Math.Sin(tick / 24.0));
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Üzenetek (pl. fájlrendszer-ellenőrzés) ---
msg.sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.55, 0.63, 0.71);
    msg.sprite.SetImage(img);
    msg.sprite.SetPosition(cx - img.GetWidth() / 2, bar_y + 28, 10);
    msg.sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(message_callback);

# --- Jelszókérés (titkosított lemez) ---
pw.prompt = Sprite();
pw.dots = Sprite();
fun password_callback(prompt, bullets) {
    p = Image.Text(prompt, 0.91, 0.93, 0.96);
    pw.prompt.SetImage(p);
    pw.prompt.SetPosition(cx - p.GetWidth() / 2, bar_y + 28, 10);
    s = "";
    for (i = 0; i < bullets; i++) s += "•";
    d = Image.Text(s, 0.18, 0.77, 0.71);
    pw.dots.SetImage(d);
    pw.dots.SetPosition(cx - d.GetWidth() / 2, bar_y + 58, 10);
    pw.prompt.SetOpacity(1);
    pw.dots.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    pw.prompt.SetOpacity(0);
    pw.dots.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# --- Leállítás / újraindítás: a sáv megtelik, a logó marad ---
fun quit_callback() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
