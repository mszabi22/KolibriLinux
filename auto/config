#!/bin/sh
# Kolibri Linux - live-build konfiguráció (Debian 13 "trixie" stable + Xfce)
lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --parent-archive-areas "main contrib non-free-firmware" \
    --security true \
    --updates true \
    --binary-images iso-hybrid \
    --debian-installer none \
    --iso-application "Kolibri Linux" \
    --iso-publisher "Kolibri Linux" \
    --iso-volume "KOLIBRI" \
    --image-name kolibri \
    --apt-recommends true \
    --memtest none \
    --bootappend-live "boot=live components quiet splash locales=hu_HU.UTF-8 keyboard-layouts=hu timezone=Europe/Budapest" \
    "${@}"
